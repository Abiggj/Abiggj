map $http_user_agent $is_crawler {
    default 0;
    ~*(LinkedInBot|Twitterbot|facebookexternalhit|WhatsApp|Slackbot|Discordbot|TelegramBot|Pinterest|Googlebot|bingbot|Baiduspider|yandex) 1;
}

server {
    listen ${PORT};
    server_name localhost;

    # Proxy crawlers to backend Open Graph endpoint, serve SPA to humans
    location ~ ^/blog/(.+) {
        if ($is_crawler) {
            proxy_pass ${BACKEND_URL}/api/blog/og/$1;
            break;
        }
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Proxy uploaded static media requests to the backend
    location /uploads/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
